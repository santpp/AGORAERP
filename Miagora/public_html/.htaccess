# ───────────────────────────────────────────────────────────────────────────
# Agora Digital App · servidor v11 · public_html/.htaccess (Hostinger, LiteSpeed/Apache)
# El código del servidor está en ../agora_app (fuera de la web). Aquí solo hay
# tres puntos de entrada PHP: index.php (la app), api/index.php y la trampa.
# ───────────────────────────────────────────────────────────────────────────
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php
AddDefaultCharset UTF-8
FileETag None

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Siempre HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) TRAMPA DE CÓDIGO FUENTE: archivos ocultos (.env, .git…), carpetas internas, respaldos,
#    archivos de código o configuración y rutas típicas de escáneres → se registra, se avisa por
#    correo a los administradores y la IP se bloquea si insiste. Siempre responde 404.
RewriteRule ^seguridad/trampa\.php$ - [L]
RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known/) [NC,OR]
RewriteCond %{REQUEST_URI} (agora_app|/storage/|/database/|/vendor/|/node_modules/|/src/|/tools/|/cron/|/templates/|composer\.(json|lock)|package\.json) [NC,OR]
RewriteCond %{REQUEST_URI} \.(sql|bak|old|orig|save|swp|swo|zip|tar|tgz|gz|7z|rar|agbk|log|ini|phps|phtml|inc|env|sh|bash|yml|yaml|lock|md|map|ts|py|go)$ [NC,OR]
RewriteCond %{REQUEST_URI} (wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|adminer|cgi-bin|phpinfo|server-status|/\.git|/\.svn) [NC]
RewriteRule ^ seguridad/trampa.php [L]

# 3) Ningún otro .php se ejecuta (si alguien sube uno, cae en la trampa)
RewriteCond %{REQUEST_URI} \.ph(p\d?|ar|tml)$ [NC]
RewriteCond %{REQUEST_URI} !^/(index\.php|api/index\.php)$
RewriteRule ^ seguridad/trampa.php [L]

# 4) API
RewriteRule ^api/ api/index.php [L,QSA]

# 5) Archivos reales (estilos, scripts con huella, íconos, manifest, sw.js, fx/actual.json)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 6) Todo lo demás es la app
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Cabeceras de seguridad para los archivos estáticos (las respuestas PHP ponen las suyas, con CSP y nonce)
<IfModule mod_headers.c>
  Header always unset X-Powered-By
  <FilesMatch "\.(js|css|webp|png|jpg|svg|ico|woff2|json|webmanifest|txt)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000"
    Header set Cross-Origin-Resource-Policy "same-origin"
    Header set X-Frame-Options "SAMEORIGIN"
  </FilesMatch>
  # scripts y estilos con huella en el nombre (app.3f2a9c.js): un año en caché
  <FilesMatch "\.[0-9a-f]{8,}\.(js|css|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Límite de tamaño de las peticiones (8 MB, igual que API_MAX_BODY)
LimitRequestBody 8388608
