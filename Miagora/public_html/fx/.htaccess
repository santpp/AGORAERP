# Tasas publicadas por la tarea programada (información pública de mercado). Solo actual.json.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !/fx/actual\.json$
RewriteRule ^ - [R=404,L]
</IfModule>
<IfModule mod_headers.c>
<Files "actual.json">
  Header set Cache-Control "public, max-age=60"
  Header set X-Content-Type-Options "nosniff"
</Files>
</IfModule>
