# ───────────────────────────────────────────────────────────────────────────
# Agora Digital App · servidor v11 · configuración (agora_app/.env)
# Este archivo vive FUERA de public_html y debe tener permiso 600.
# Créalo con:  php agora_app/tools/instalar.php --generar-env
# (genera los cuatro secretos al azar). Nunca lo subas a Git ni lo compartas.
# ───────────────────────────────────────────────────────────────────────────

# --- Aplicación -------------------------------------------------------------
APP_ENV=production
APP_URL=https://app.agoradigital.app
# Otros orígenes permitidos (separados por coma), p. ej. el dominio temporal de Hostinger
APP_EXTRA_ORIGINS=
# Carpeta pública (por defecto: ../public_html al lado de agora_app)
PUBLIC_DIR=

# --- Base de datos (hPanel → Bases de datos → MySQL) -------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_agora
DB_USERNAME=u000000000_agora
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=

# --- Secretos (48 bytes al azar; los genera instalar.php) -------------------
# AUDIT_KEY: sella la auditoría y los documentos fiscales (HMAC encadenado)
AUDIT_KEY=cambia-esto
# OTP_PEPPER: los códigos de verificación solo se guardan mezclados con este secreto
OTP_PEPPER=cambia-esto
# INTEGRITY_KEY: firma el manifiesto de archivos (vigilancia del código)
INTEGRITY_KEY=cambia-esto
# BACKUP_KEY: cifra los respaldos. GUÁRDALA TAMBIÉN FUERA DEL SERVIDOR: sin ella no se restauran.
BACKUP_KEY=cambia-esto

# --- Sesiones y acceso --------------------------------------------------------
COOKIE_SECURE=true
SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=7
TRUSTED_DEVICE_DAYS=30
# minutos del modo edición (equivale a la clave de edición de la edición local)
EDIT_MINUTES=15
# minutos que dura una verificación con código para acciones sensibles
STEPUP_MINUTES=10
# exigir código al entrar a TODAS las personas (Dirección y Superadministrador siempre lo tienen)
MFA_TODOS=false
# tiempo mínimo de respuesta al pedir recuperación (oculta si la cuenta existe)
RECOVERY_MIN_MS=1200
INVITATION_DAYS=7
HSTS_MAX_AGE=31536000
HSTS_SUBDOMAINS=false

# --- Proxy / CDN --------------------------------------------------------------
# Si usas Cloudflare u otro proxy delante: sus rangos de IP y la cabecera con la IP real
TRUSTED_PROXIES=
IP_HEADER=
# Límites de peticiones por IP y por sesión cada 5 minutos (una oficina o el CGNAT de un proveedor comparten IP)
RATE_IP_LIMIT=1200
RATE_SESSION_LIMIT=900
# Entradas por IP cada 15 minutos: tope amplio para las correctas y estricto para las FALLIDAS
RATE_LOGIN_IP=300
RATE_LOGIN_FAIL_IP=30
API_MAX_BODY=8388608

# --- Correo (hPanel → Correos; SMTP de Hostinger) ---------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USERNAME=no-responder@agoradigital.app
MAIL_PASSWORD=
MAIL_FROM=no-responder@agoradigital.app
MAIL_FROM_NAME="Agora Digital App"
# Correos que reciben los avisos de seguridad (además de los administradores de la plataforma)
ALERT_EMAILS=seguridad@agoradigital.app

# --- WhatsApp (API oficial de Meta, WhatsApp Cloud API) ---------------------
# driver: cloud (producción), archivo (pruebas), nulo (apagado)
WHATSAPP_DRIVER=nulo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v25.0
# Plantilla de categoría "Autenticación" con botón de copiar código, aprobada en el Administrador de WhatsApp
WHATSAPP_TEMPLATE_OTP=agora_codigo_verificacion
WHATSAPP_TEMPLATE_LANG=es

# --- Tasas ----------------------------------------------------------------------
FX_EVERY_MIN=5
FX_QUOTE_MINUTES=15
# Solo si un servidor intermedio exige otro paquete de certificados
HTTP_CA_BUNDLE=

# --- Respaldos ------------------------------------------------------------------
BACKUP_HOUR=3
BACKUP_DIR=
# Copia fuera del servidor (opcional, cualquier almacenamiento compatible con S3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_PREFIX=agora

# --- Mantenimiento --------------------------------------------------------------
DOC_HISTORY_KEEP=50
SLOW_REQUEST_MS=2500
APP_DEBUG=false
