# Copia este archivo a .env y completa los valores. NO subas .env a Git.
# Base de datos. SQLite (un archivo) o MySQL/MariaDB (recomendado en producción; ver docs/mysql.md)
CONTRATOS_BD=sqlite:/home/usuario/contratos/storage/contratos.sqlite
# CONTRATOS_BD=mysql:host=localhost;dbname=contratos;charset=utf8mb4
# CONTRATOS_BD_USUARIO=contratos_app
# CONTRATOS_BD_CLAVE=pega-aqui-la-clave-de-la-base
# Secreto que GHL envía en la cabecera X-Webhook-Secret (genera uno largo y aleatorio)
GHL_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo

# GoHighLevel: token de la Private Integration de la subcuenta y su location ID (para correos al cliente)
GHL_TOKEN=pega-aqui-el-token-nuevo
GHL_LOCATION_ID=pega-aqui-el-location-id
# Dirección pública de la app (la usan los enlaces de los correos)
APP_URL=https://tests.agoradigital.app
# Clave para cifrar los enlaces de firma que se muestran en el panel (una cadena larga y aleatoria; no la cambies después)
APP_CLAVE=pega-aqui-una-clave-larga-y-aleatoria
