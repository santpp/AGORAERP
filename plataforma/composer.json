{
    "name": "agora/plataforma",
    "description": "Plataforma de convenios de pago para varias empresas (Agora)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Agora\\Plataforma\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agora\\Plataforma\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
