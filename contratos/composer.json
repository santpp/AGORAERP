{
    "name": "asocim/contratos",
    "description": "Motor de cálculo de contratos de pago (ASOCIM)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
