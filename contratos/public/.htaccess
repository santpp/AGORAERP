RewriteEngine On
RewriteRule ^api/ index.php [L,QSA]
RewriteRule ^firmar$ firmar.php [L,QSA]
# Panel del personal (Angular) en la raíz: la portada y sus rutas caen en panel.html
RewriteRule ^$ panel.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(entrar|contratos(/.*)?)$ panel.html [L]
